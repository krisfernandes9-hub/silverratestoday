---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const gradients = [
  'linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)',
  'linear-gradient(135deg, #0d0d0d 0%, #1a1a1a 50%, #2d2d2d 100%)',
  'linear-gradient(135deg, #0f0f0f 0%, #1c2b1c 50%, #0d1f0d 100%)',
  'linear-gradient(135deg, #1a0a00 0%, #2d1500 50%, #1a0a00 100%)',
  'linear-gradient(135deg, #0a0a1a 0%, #0d0d2e 50%, #0a0a1a 100%)',
  'linear-gradient(135deg, #0d1a0d 0%, #0a2a0a 50%, #051405 100%)',
  'linear-gradient(135deg, #1a1a0a 0%, #2a2a05 50%, #1a1a0a 100%)',
  'linear-gradient(135deg, #1a0505 0%, #2d0a0a 50%, #1a0505 100%)',
];

const icons = ['📈', '⚖️', '🌿', '📊', '🔬', '🇬🇧', '🇮🇳', '🧮'];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Market Insights | ${SITE_TITLE}`} description="Silver market analysis, price forecasts and investment guides." />
    <style>
      body {
        background: #f5f5f3;
        margin: 0;
        font-family: 'Times New Roman', Georgia, serif;
      }
      .blog-hero {
        background: #0f0f0f;
        border-bottom: 1px solid #222;
        padding: 2.5rem 1.5rem 2rem;
        text-align: center;
      }
      .blog-hero h1 {
        color: #fff;
        font-family: 'Times New Roman', serif;
        font-size: 1.75rem;
        margin: 0 0 0.5rem;
        font-weight: 400;
      }
      .blog-hero p {
        color: #888;
        font-size: 0.9rem;
        margin: 0;
      }
      .section-label {
        display: inline-block;
        border-left: 3px solid #c0c0c0;
        padding-left: 0.75rem;
        color: #c0c0c0;
        font-style: italic;
        font-size: 1rem;
        margin-bottom: 1.5rem;
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
      }
      .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .post-card {
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .post-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 24px rgba(0,0,0,0.13);
      }
      .post-card a {
        text-decoration: none;
        display: block;
      }
      .card-image {
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        position: relative;
        overflow: hidden;
      }
      .card-image::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 40px;
        background: linear-gradient(transparent, rgba(0,0,0,0.3));
      }
      .card-body {
        padding: 1.1rem 1.25rem 1.25rem;
      }
      .card-title {
        color: #111;
        font-family: 'Times New Roman', serif;
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.35;
        margin: 0 0 0.5rem;
      }
      .card-date {
        color: #888;
        font-size: 0.78rem;
        margin: 0;
        font-family: Arial, sans-serif;
      }
      .card-read {
        display: inline-block;
        margin-top: 0.75rem;
        color: #555;
        font-size: 0.8rem;
        font-family: Arial, sans-serif;
        border-bottom: 1px solid #ddd;
        padding-bottom: 1px;
      }
      .post-card:hover .card-read {
        color: #111;
        border-color: #111;
      }
    </style>
  </head>
  <body>
    <Header />
    <div class="blog-hero">
      <h1>Market Insights</h1>
      <p>Silver price analysis, investment guides & global market data</p>
    </div>
    <main>
      <p class="section-label">Latest Articles</p>
      <ul class="posts-grid">
        {posts.map((post, i) => (
          <li class="post-card">
            <a href={`/blog/${post.id}/`}>
              <div class="card-image" style={`background: ${gradients[i % gradients.length]}`}>
                <span>{icons[i % icons.length]}</span>
              </div>
              <div class="card-body">
                <h2 class="card-title">{post.data.title}</h2>
                <p class="card-date">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                <span class="card-read">Read article →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>