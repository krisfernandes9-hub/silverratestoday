---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      body {
        background: #f5f5f3;
        margin: 0;
        font-family: 'Times New Roman', Georgia, serif;
      }
      .article-hero {
        background: #0f0f0f;
        padding: 2.5rem 1.5rem 2rem;
        text-align: center;
        border-bottom: 1px solid #222;
      }
      .article-hero .back-link {
        display: inline-block;
        color: #888;
        text-decoration: none;
        font-size: 0.82rem;
        font-family: Arial, sans-serif;
        margin-bottom: 1.25rem;
        letter-spacing: 0.02em;
      }
      .article-hero .back-link:hover { color: #ccc; }
      .article-hero h1 {
        color: #fff;
        font-family: 'Times New Roman', serif;
        font-size: clamp(1.5rem, 4vw, 2.2rem);
        font-weight: 400;
        line-height: 1.25;
        max-width: 800px;
        margin: 0 auto 0.75rem;
      }
      .article-meta {
        color: #777;
        font-size: 0.82rem;
        font-family: Arial, sans-serif;
      }
      .article-meta .updated {
        font-style: italic;
        margin-left: 0.75rem;
      }
      .hero-image {
        max-width: 860px;
        margin: 2rem auto 0;
        border-radius: 10px;
        overflow: hidden;
      }
      .hero-image img {
        width: 100%;
        display: block;
      }
      article {
        max-width: 720px;
        margin: 2.5rem auto;
        padding: 0 1.5rem 3rem;
      }
      article :global(h2) {
        font-family: 'Times New Roman', serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: #111;
        margin: 2rem 0 0.75rem;
        border-bottom: 2px solid #e8e8e8;
        padding-bottom: 0.4rem;
      }
      article :global(h3) {
        font-family: 'Times New Roman', serif;
        font-size: 1.2rem;
        color: #222;
        margin: 1.5rem 0 0.5rem;
      }
      article :global(p) {
        color: #333;
        line-height: 1.8;
        font-size: 1.05rem;
        margin: 0 0 1.25rem;
      }
      article :global(ul), article :global(ol) {
        color: #333;
        line-height: 1.8;
        font-size: 1.05rem;
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
      }
      article :global(li) { margin-bottom: 0.4rem; }
      article :global(strong) { color: #111; }
      article :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.95rem;
        font-family: Arial, sans-serif;
      }
      article :global(th) {
        background: #0f0f0f;
        color: #fff;
        padding: 0.6rem 1rem;
        text-align: left;
        font-weight: 600;
      }
      article :global(td) {
        padding: 0.55rem 1rem;
        border-bottom: 1px solid #e8e8e8;
        color: #333;
      }
      article :global(tr:nth-child(even) td) { background: #f9f9f7; }
      article :global(blockquote) {
        border-left: 3px solid #c0c0c0;
        margin: 1.5rem 0;
        padding: 0.75rem 1.25rem;
        background: #f0f0ee;
        color: #555;
        font-style: italic;
      }
      article :global(a) { color: #1a5276; }
      article :global(hr) {
        border: none;
        border-top: 1px solid #e0e0e0;
        margin: 2rem 0;
      }
      .back-bottom {
        max-width: 720px;
        margin: 0 auto 2rem;
        padding: 0 1.5rem;
      }
      .back-bottom a {
        color: #555;
        font-size: 0.85rem;
        font-family: Arial, sans-serif;
        text-decoration: none;
        border-bottom: 1px solid #ccc;
        padding-bottom: 1px;
      }
      .back-bottom a:hover { color: #111; }
    </style>
  </head>
  <body>
    <Header />
    <div class="article-hero">
      <a href="/blog" class="back-link">← Market Insights</a>
      <h1>{title}</h1>
      <div class="article-meta">
        {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {updatedDate && <span class="updated">Updated: {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>}
      </div>
      {heroImage && (
        <div class="hero-image">
          <Image width={1020} height={510} src={heroImage} alt="" />
        </div>
      )}
    </div>
    <article>
      <slot />
    </article>
    <div class="back-bottom">
      <a href="/blog">← Back to Market Insights</a>
    </div>
    <Footer />
  </body>
</html>